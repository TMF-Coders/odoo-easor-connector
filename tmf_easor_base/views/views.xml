<odoo>
  <record id="backend_list" model="ir.ui.view"><field name="name">tmf.easor.backend.list</field><field name="model">tmf.easor.backend</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="business_id"/><field name="origin"/><field name="writes_enabled"/><field name="active"/></list></field></record>
  <record id="backend_form" model="ir.ui.view"><field name="name">tmf.easor.backend.form</field><field name="model">tmf.easor.backend</field><field name="arch" type="xml"><form><header><button name="action_check" type="object" string="Verificar acceso (solo lectura)"/></header><sheet><div role="status" class="alert alert-warning">Solo API española. Las escrituras están desactivadas por defecto. La clave se configura en el servidor, nunca en este formulario.</div><group><field name="name"/><field name="active"/><field name="company_id"/><field name="origin"/><field name="business_id"/><field name="api_key_env" groups="tmf_easor_base.group_manager"/><field name="series_id"/><field name="activity_id"/><field name="writes_enabled"/></group></sheet></form></field></record>
  <record id="binding_list" model="ir.ui.view"><field name="name">tmf.easor.binding.list</field><field name="model">tmf.easor.binding</field><field name="arch" type="xml"><list><field name="backend_id"/><field name="company_id"/><field name="kind"/><field name="partner_id"/><field name="product_id"/><field name="remote_id"/><field name="unit"/></list></field></record>
  <record id="binding_form" model="ir.ui.view"><field name="name">tmf.easor.binding.form</field><field name="model">tmf.easor.binding</field><field name="arch" type="xml"><form><sheet><group><field name="backend_id"/><field name="company_id"/><field name="kind"/><field name="partner_id" invisible="kind != 'merchant'" required="kind == 'merchant'"/><field name="product_id" invisible="kind != 'product'" required="kind == 'product'"/><field name="remote_id"/><field name="unit" invisible="kind != 'product'"/></group></sheet></form></field></record>
  <record id="backend_action" model="ir.actions.act_window"><field name="name">Conexiones</field><field name="res_model">tmf.easor.backend</field><field name="view_mode">list,form</field></record>
  <record id="binding_action" model="ir.actions.act_window"><field name="name">Equivalencias</field><field name="res_model">tmf.easor.binding</field><field name="view_mode">list,form</field></record>
  <menuitem id="root_menu" name="Easor" groups="group_user" sequence="65"/>
  <menuitem id="backend_menu" name="Conexiones" parent="root_menu" action="backend_action" groups="group_manager" sequence="80"/>
  <menuitem id="binding_menu" name="Equivalencias" parent="root_menu" action="binding_action" groups="group_manager" sequence="90"/>
</odoo>
