<odoo>
  <record id="journal_form" model="ir.ui.view"><field name="name">account.journal.easor</field><field name="model">account.journal</field><field name="inherit_id" ref="account.view_account_journal_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Easor" groups="tmf_easor_base.group_manager"><field name="easor_backend_id" domain="[('company_id', '=', company_id)]"/></group></xpath></field></record>
  <record id="tax_form" model="ir.ui.view"><field name="name">account.tax.easor</field><field name="model">account.tax</field><field name="inherit_id" ref="account.view_tax_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Easor" groups="tmf_easor_base.group_manager"><field name="easor_ordinary_vat"/></group></xpath></field></record>
  <record id="invoice_form" model="ir.ui.view"><field name="name">account.move.easor</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml">
    <xpath expr="//header" position="inside"><button name="action_easor_prepare" type="object" string="Preparar en Easor" groups="tmf_easor_base.group_user" invisible="not easor_managed or easor_job_id or state != 'draft'" confirm="Se congelará esta versión y se creará un borrador remoto. La emisión requiere una segunda autorización."/><button name="action_easor_job" type="object" string="Operación Easor" groups="tmf_easor_base.group_user" invisible="not easor_job_id"/><button name="action_easor_post_mirror" type="object" string="Contabilizar copia operativa" groups="tmf_easor_base.group_issuer" invisible="easor_state != 'done' or state == 'posted'" confirm="Se contabilizará exclusivamente la copia local con el número de Easor. No se enviará otro asiento a Easor."/></xpath>
    <xpath expr="//sheet" position="inside"><group string="Facturación delegada en Easor" invisible="not easor_managed"><field name="easor_managed" invisible="1"/><field name="easor_job_id" readonly="1"/><field name="easor_state" readonly="1"/><field name="easor_payment_method" readonly="easor_job_id"/><field name="easor_language" readonly="easor_job_id"/><div role="status" class="alert alert-info" colspan="2">Easor emite y mantiene la contabilidad oficial. La contabilidad local es una copia operativa parcial. El estado de emisión no certifica aceptación tributaria.</div></group></xpath>
  </field></record>
  <record id="job_list" model="ir.ui.view"><field name="name">tmf.easor.job.list</field><field name="model">tmf.easor.job</field><field name="arch" type="xml"><list create="0" delete="0" decoration-danger="state in ('unknown', 'blocked')"><field name="move_id"/><field name="company_id"/><field name="state"/><field name="remote_id"/><field name="number"/><field name="payment_status"/><field name="attempts"/><field name="next_attempt"/></list></field></record>
  <record id="job_form" model="ir.ui.view"><field name="name">tmf.easor.job.form</field><field name="model">tmf.easor.job</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><header><button name="action_approve_issue" type="object" string="Autorizar emisión en Easor" groups="tmf_easor_base.group_issuer" invisible="state != 'review'" confirm="Autoriza la emisión fiscal de este borrador verificado. No es una simulación ni una exportación de prueba."/><button name="action_retry_safe" type="object" string="Recuperar / actualizar sin duplicar" groups="tmf_easor_base.group_issuer" invisible="state not in ('blocked', 'unknown', 'creating', 'issuing', 'done')"/><button name="action_pdf" type="object" string="Descargar PDF original" invisible="not pdf_id"/><field name="state" widget="statusbar" statusbar_visible="queued,review,issue_queued,done"/></header><sheet><group><field name="move_id"/><field name="backend_id"/><field name="company_id"/><field name="requested_by"/><field name="approved_by"/><field name="remote_id"/><field name="number"/><field name="payment_status"/><field name="last_write"/><field name="fenced_at"/><field name="attempts"/><field name="next_attempt"/><field name="pdf_id"/><field name="pdf_sha256"/><field name="fingerprint"/><field name="error"/></group><div role="status" class="alert alert-warning">Resultado desconocido: no vuelva a crear ni a emitir el documento. La recuperación solo consulta o vincula un documento verificado. El estado fiscal detallado no está expuesto por esta integración.</div><notebook><page string="Instantánea aprobada"><field name="snapshot"/></page><page string="Historial"><field name="event_ids"><list create="0" edit="0" delete="0"><field name="create_date"/><field name="actor_id"/><field name="action"/></list></field></page></notebook></sheet></form></field></record>
  <record id="recovery_form" model="ir.ui.view"><field name="name">tmf.easor.recovery.form</field><field name="model">tmf.easor.recovery</field><field name="arch" type="xml"><form><div role="status" class="alert alert-warning">Compruebe en Easor el origen exacto, no solo cliente e importe. Esta acción no crea ni emite documentos.</div><group><field name="job_id" readonly="1"/><field name="remote_id"/><field name="already_issued"/><field name="reason"/></group><footer><button name="action_link" type="object" string="Verificar y vincular" class="btn-primary"/><button special="cancel" string="Cancelar"/></footer></form></field></record>
  <record id="job_action" model="ir.actions.act_window"><field name="name">Operaciones de facturación</field><field name="res_model">tmf.easor.job</field><field name="view_mode">list,form</field></record>
  <menuitem id="job_menu" name="Facturación" parent="tmf_easor_base.root_menu" action="job_action" groups="tmf_easor_base.group_user" sequence="10"/>
</odoo>
